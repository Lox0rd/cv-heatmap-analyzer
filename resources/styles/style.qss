/* Control room palette: blue, white and cool neutrals. */
QWidget { color: #18324A; font-family: Arial; font-size: 13px; }
QMainWindow, QWidget#centralWidget, QWidget#workspace { background: #EDF3F8; }
QFrame#appHeader { background: #064F91; border-bottom: 4px solid #0075BE; }
QFrame#appHeader QLabel { background: transparent; }
QLabel#headerEyebrow { color: #A8D6F4; font-size: 10px; font-weight: bold; }
QLabel#headerTitle { color: #FFFFFF; font-size: 21px; font-weight: bold; }
QLabel#headerModule { color: #E0F0FA; font-size: 11px; font-weight: bold; }
QFrame#sidebar, QFrame#viewerPanel { background: #FFFFFF; border: 1px solid #D8E3ED; border-radius: 8px; }
QLabel#sectionTitle { color: #103D63; background: transparent; font-size: 17px; font-weight: bold; }
QLabel#viewerBadge { color: #0870B5; background: #E8F4FB; border: 1px solid #CBE6F6; border-radius: 11px; padding: 5px 10px; font-size: 10px; font-weight: bold; }
QScrollArea#settingsScroll { background: #FFFFFF; border: none; }
QScrollArea#settingsScroll > QWidget > QWidget { background: #FFFFFF; }
QScrollBar:vertical { background: #F3F7FA; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #BDD0DE; min-height: 28px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QGroupBox { color: #14527F; background: #FFFFFF; border: 1px solid #DDE7EF; border-radius: 6px; margin-top: 12px; padding: 14px 10px 10px 10px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0 5px; background: #FFFFFF; }
QLabel { background: transparent; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { color: #17354D; background: #F8FBFD; border: 1px solid #CBD9E4; border-radius: 4px; padding: 6px 8px; min-height: 22px; selection-background-color: #0075BE; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #84B8D9; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #0075BE; background: #FFFFFF; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { color: #8A9BA8; background: #EDF2F5; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView { color: #17354D; background: #FFFFFF; border: 1px solid #CBD9E4; selection-background-color: #D8EEFA; selection-color: #103D63; outline: none; }
QPushButton { color: #FFFFFF; background: #0075BE; border: 1px solid #0075BE; border-radius: 4px; padding: 8px 13px; min-height: 20px; font-weight: bold; }
QPushButton:hover { background: #0066A6; border-color: #0066A6; }
QPushButton:pressed { background: #05568B; }
QPushButton:disabled { color: #91A3B1; background: #E8EFF4; border-color: #D9E3EA; }
QPushButton#browseButton, QPushButton#stopButton { color: #086AA8; background: #FFFFFF; border: 1px solid #9FC6DF; }
QPushButton#browseButton:hover, QPushButton#stopButton:hover { background: #EAF5FC; }
QPushButton#stopButton:disabled { color: #91A3B1; background: #F5F8FA; border-color: #D9E3EA; }
QCheckBox { spacing: 8px; padding: 4px 0; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid #A8BECE; border-radius: 3px; background: #FFFFFF; }
QCheckBox::indicator:checked { image: url(resources/styles/selected.svg); background: #0075BE; border-color: #0075BE; }
QCheckBox:disabled { color: #9AABB6; }
QSlider::groove:horizontal { height: 6px; background: #DCE8F0; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #0075BE; border-radius: 3px; }
QSlider::handle:horizontal { width: 16px; height: 16px; margin: -6px 0; background: #FFFFFF; border: 2px solid #0075BE; border-radius: 9px; }
QSlider::handle:horizontal:disabled { border-color: #B5C6D2; }
QLabel#statusLabel { color: #49697E; background: #EEF6FB; border-left: 3px solid #0075BE; border-radius: 2px; padding: 10px; }
QLabel#videoDisplay { color: #A9C2D4; background: #112C43; border: 1px solid #163D5B; border-radius: 6px; font-size: 18px; font-weight: bold; }
QLabel#heatmapDisplay { color: #A9C2D4; background: #112C43; border-radius: 6px; }
QTabWidget#mainTabs::pane { border: none; background: #EDF3F8; }
QTabWidget#mainTabs QTabBar { background: #FFFFFF; }
QTabWidget#mainTabs QTabBar::tab { color: #547086; background: #FFFFFF; border: none; border-bottom: 3px solid transparent; padding: 13px 22px; font-weight: bold; }
QTabWidget#mainTabs QTabBar::tab:hover { color: #0075BE; background: #F3F9FD; }
QTabWidget#mainTabs QTabBar::tab:selected { color: #075B94; border-bottom: 3px solid #0075BE; }
QWidget#placeholderPage { background: #EDF3F8; }
QLabel#placeholderText { color: #6C8799; font-size: 20px; font-weight: bold; }
QFrame#zoneControls { background: #FFFFFF; border: 1px solid #D8E3ED; border-radius: 8px; }
QLabel#zoneCanvas { background: #112C43; border: 1px solid #163D5B; border-radius: 6px; }
QLabel#zoneHint { color: #49697E; background: #EEF6FB; border-left: 3px solid #0075BE; padding: 10px; }
QListWidget#zoneList { color: #17354D; background: #F8FBFD; border: 1px solid #CBD9E4; border-radius: 4px; padding: 5px; }
QListWidget#zoneList::item { padding: 7px; }
QListWidget#zoneList::item:selected { color: #075B94; background: #D8EEFA; }
QPushButton#secondaryButton { color: #086AA8; background: #FFFFFF; border: 1px solid #9FC6DF; }
QPushButton#secondaryButton:hover { background: #EAF5FC; }
QPushButton#secondaryButton:disabled { color: #91A3B1; background: #F5F8FA; border-color: #D9E3EA; }
QPushButton#settingsButton { color: #FFFFFF; background: transparent; border: 1px solid #9BC9E7; padding: 7px 16px; }
QPushButton#settingsButton:hover { background: #1265A1; }
QDialog#settingsDialog { background: #FFFFFF; }
QTextEdit#promptInput, QTextEdit#resultOutput { color: #17354D; background: #F8FBFD; border: 1px solid #CBD9E4; border-radius: 4px; padding: 8px; selection-background-color: #0075BE; }
QTextEdit#promptInput:focus { border: 1px solid #0075BE; background: #FFFFFF; }
QTextEdit#resultOutput { background: #FFFFFF; }
